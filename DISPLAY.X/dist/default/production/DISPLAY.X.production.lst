  8057                           
  8058                           ;Config register CONFIG1 @ 0x2007
  8059                           ;	Oscillator Selection bits
  8060                           ;	FOSC = INTRC_NOCLKOUT, INTOSCIO oscillator: I/O function on RA6/OSC2/CLKOUT pin, I/O f
      +                          unction on RA7/OSC1/CLKIN
  8061                           ;	Watchdog Timer Enable bit
  8062                           ;	WDTE = OFF, WDT disabled and can be enabled by SWDTEN bit of the WDTCON register
  8063                           ;	Power-up Timer Enable bit
  8064                           ;	PWRTE = OFF, PWRT disabled
  8065                           ;	RE3/MCLR pin function select bit
  8066                           ;	MCLRE = ON, RE3/MCLR pin function is MCLR
  8067                           ;	Code Protection bit
  8068                           ;	CP = OFF, Program memory code protection is disabled
  8069                           ;	Data Code Protection bit
  8070                           ;	CPD = OFF, Data memory code protection is disabled
  8071                           ;	Brown Out Reset Selection bits
  8072                           ;	BOREN = ON, BOR enabled
  8073                           ;	Internal External Switchover bit
  8074                           ;	IESO = OFF, Internal/External Switchover mode is disabled
  8075                           ;	Fail-Safe Clock Monitor Enabled bit
  8076                           ;	FCMEN = OFF, Fail-Safe Clock Monitor is disabled
  8077                           ;	Low Voltage Programming Enable bit
  8078                           ;	LVP = OFF, RB3 pin has digital I/O, HV on MCLR must be used for programming
  8079                           ;	In-Circuit Debugger Mode bit
  8080                           ;	DEBUG = 0x1, unprogrammed default
  8081     2007                     	org	8199
  8082     2007  23F4               	dw	9204
  8083                           
  8084                           ;Config register CONFIG2 @ 0x2008
  8085                           ;	Brown-out Reset Selection bit
  8086                           ;	BOR4V = BOR21V, Brown-out Reset set to 2.1V
  8087                           ;	Flash Program Memory Self Write Enable bits
  8088                           ;	WRT = OFF, Write protection off
  8089     2008                     	org	8200
  8090     2008  3EFF               	dw	16127
